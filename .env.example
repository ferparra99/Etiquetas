# Copiar a .env y ajustar. Todo tiene valor por defecto en docker-compose.yml.
POSTGRES_DB=etiquetas
POSTGRES_USER=etiquetas
POSTGRES_PASSWORD=cambia_esto

# --- Presets del OCR (se aplican al reiniciar el servicio `ocr`) ---
# OCR_DET_MODEL=PP-OCRv5_mobile_det
# OCR_REC_MODEL=PP-OCRv5_mobile_rec
# OCR_DOC_ORIENTATION=false
# OCR_DOC_UNWARPING=false
# OCR_TEXTLINE_ORIENTATION=true
# Opcionales (vacío = valor por defecto de PaddleOCR):
# OCR_DET_LIMIT_SIDE_LEN=1280
# OCR_DET_LIMIT_TYPE=max
# OCR_DET_THRESH=0.3
# OCR_DET_BOX_THRESH=0.6
# OCR_DET_UNCLIP_RATIO=1.8
# OCR_REC_SCORE_THRESH=0.0
