# ===== Aplicación =====
APP_NAME=etiquetas
APP_ENV=dev
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
FRONTEND_PORT=4200

# ===== Base de datos (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=etiquetas_db
DB_USER=etiquetas_user
DB_PASSWORD=

# ===== Logs =====
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# ===== Escaneo / OCR =====
OCR_LANGUAGE=eng
OCR_CHAR_WHITELIST=ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-

# ===== Historial =====
SCAN_HISTORY_MAX_ITEMS=10

# ===== Importación de inventario =====
IMPORT_MAX_FILE_SIZE_MB=20

# ===== Proyecto por defecto (v1: un solo cliente) =====
DEFAULT_PROJECT_CODE=default
